generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id @default(uuid())
  name     String 
  email     String?    @unique
  password String
  phonenum String?
  director Owner?
  manager  Manager?
}

model Owner{
  id String @id @default(uuid())
  companyname String?
  userId String @unique
  managers Manager[]
  inn String?
  bik String?
  ogrn String?
  categories Category[]
  brandname String?
  user      User    @relation(fields: [userId], references: [id])
}
model Category{
  id String @id @default(uuid())
  name String
  ownerId String
  owner Owner @relation(fields: [ownerId], references: [id])
  cities City[]
}
model City{
  id String @id @default(uuid())
  cityname String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  points Point[]
  timetable Timetable[]
}
model Timetable{
  id String @id @default(uuid())
  point Point @relation(fields: [pointId], references: [id])
  pointId String 
  managerId String
  manager Manager @relation(fields: [managerId], references: [id])
  date DateTime
  cityId String
  city City @relation(fields: [cityId], references: [id])
  time_start String
  time_end String
}
model Point{
  id String @id @default(uuid())
  address String
  name String
  cityId String
  city City @relation(fields: [cityId], references: [id])
  managers Manager[]
  shifts Shift[]
  clients Client[]
  realizations Realization[]
  delivers Deliver[]
  timetable Timetable[]
  products Product[]
}
model Shift{
  id String @id @default(uuid())
  pointId String
  point Point @relation(fields: [pointId], references: [id])
  date_start DateTime
  date_end DateTime
  manager Manager @relation(fields: [managerId], references: [id])
  managerId String
  realization Realization[]
}
model Client{
  id String @id @default(uuid())
  name String
  phonenum String
  birth DateTime?
  pointId String
  point Point @relation(fields: [pointId], references: [id])
  realizations Realization[]
}
model Product{
  id String @id @default(uuid())
  delivers Deliver[]
  name String
  uniq_num String?
  pointId String
  point Point @relation(fields: [pointId], references: [id])
  realizations RealizationItem[]
}
model Deliver{
  id String @id @default(uuid())
  date DateTime
  productId String
  product Product @relation(fields: [productId], references: [id])
  summ Int
  pointId String
  point Point @relation(fields: [pointId], references: [id])
  buy Int
  sell Int
  receive Int
  amount Int
}

model Realization{
  id String @id @default(uuid())
  date DateTime
  clientId String 
  client Client @relation(fields: [clientId], references: [id])
  shiftId String
  shift Shift @relation(fields: [shiftId], references: [id])
  items RealizationItem[]
  summ Int
  pointId String
  point Point @relation(fields: [pointId], references: [id])
}
model RealizationItem{
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  buy Int
  sell Int
  amount Int
  summ Int
  realizationId String
  realization Realization @relation(fields: [realizationId], references: [id])
}
model Manager{
  id String @id @default(uuid())
  shift_cost Int
  ownerId String
  pointId String
  point Point @relation(fields: [pointId], references: [id])
  owner Owner @relation(fields: [ownerId], references: [id])
  personal_percent Int
  salary Salary[]
  timetable Timetable[]
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  shifts Shift[]
}
model Salary{
  id String @id @default(uuid())
  withdrawals Int?
  add_funds Int?
  balance Int
  date DateTime
  managerId String
  manager Manager @relation(fields: [managerId], references: [id])
}

